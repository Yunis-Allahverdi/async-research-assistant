# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for synthesis) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Web search provider ---
WEB_SEARCH_PROVIDER=tavily    # tavily | serper | duckduckgo
TAVILY_API_KEY=               # https://tavily.com — free 1000 req/month
# SERPER_API_KEY=             # https://serper.dev — free 2500 req
# (DuckDuckGo needs no key but the duckduckgo-search package must be installed.)

# --- SE-layer settings (names must match src/config.py's Settings fields,
# uppercased — pydantic-settings maps SOURCE_TIMEOUT -> source_timeout, etc.) ---
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL=86400
SOURCE_TIMEOUT=10
MAX_CONCURRENCY=5
MAX_RETRIES=3
RETRY_BACKOFF=1.0
MIN_QUESTION_LEN=3
MAX_QUESTION_LEN=500
